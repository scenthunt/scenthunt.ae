---
import Base from '../layouts/Base.astro';
import ProductCard from '../components/ProductCard.astro';
import { products } from '../data/catalog.js';
import settings from '../data/settings.json';
import {currency} from '../utils.js';
const published=products.filter(p=>p.active);
---
<Base title="ScentHunt | Perfume Decants & Fragrance Discovery UAE">
<section class="hero"><div class="hero-main"><div class="hero-copy"><div class="hero-kicker"><span class="sparkle">✳</span> EXPLORE · WEAR · DISCOVER</div><h1>The art of <em>finding</em> your next favourite scent<span class="period">.</span></h1><p>Beautiful fragrances deserve to be discovered, not guessed. Explore thoughtfully curated decants, from Middle Eastern treasures to modern niche icons.</p><div class="hero-cta"><a class="button-dark" href="#collection">Explore the collection <span>↗</span></a><a class="button-outline find-perfume" href="#collection" data-focus-search>⌕ Find a Perfume</a></div><div class="hero-proof"><span>✧</span> Small samples. Big feelings. <span class="dot">•</span> Curated in Abu Dhabi</div></div><div class="hero-art" aria-label="Illustrated amber perfume bottle on sculptural forms"><div class="hero-orbit orbit-a"></div><div class="hero-orbit orbit-b"></div><div class="hero-disc"></div><div class="hero-plinth"></div><div class="hero-flower flower-a">✳</div><div class="hero-flower flower-b">✽</div><div class="hero-bottle"><div class="hero-bottle-cap"></div><div class="hero-bottle-glass"><span>SCENT<br/>HUNT</span><small>DISCOVERY EDIT</small></div></div><div class="hero-art-caption">the fragrance edit <span>№ 001</span></div></div></div><div class="hero-bottom"><span>SCENT IS PERSONAL. DISCOVERY SHOULD BE FUN.</span><span>SCROLL TO EXPLORE <b>↓</b></span></div></section>
<section class="values-band"><span>✳ Curated discoveries</span><span>◌ 3 ml, 5 ml & 10 ml sizes where available</span><span>♡ Explore before committing</span><span>✧ From the UAE, with curiosity</span></section>
<section class="mood-section" id="discover"><div class="section-head"><div><span class="eyebrow">FIRST, FOLLOW YOUR FEELING</span><h2>What are you <em>in the mood</em> for?</h2></div><p>Forget the complicated fragrance vocabulary. Start with how you want to feel.</p></div><div class="moods"><a href="#collection" data-mood-shortcut="Fresh days" class="mood-tile mood-fresh"><span class="mood-icon">☼</span><span class="mood-num">01 /</span><h3>Fresh<br/>days</h3><p>Crisp, airy, energising</p><span class="mood-arrow">↗</span></a><a href="#collection" data-mood-shortcut="After dark" class="mood-tile mood-night"><span class="mood-icon">✦</span><span class="mood-num">02 /</span><h3>After<br/>dark</h3><p>Seductive, bold, magnetic</p><span class="mood-arrow">↗</span></a><a href="#collection" data-mood-shortcut="Cosy nights" class="mood-tile mood-cozy"><span class="mood-icon">◒</span><span class="mood-num">03 /</span><h3>Cosy<br/>nights</h3><p>Warm, sweet, comforting</p><span class="mood-arrow">↗</span></a><a href="#collection" data-mood-shortcut="Everyday" class="mood-tile mood-everyday"><span class="mood-icon">✳</span><span class="mood-num">04 /</span><h3>Everyday<br/>magic</h3><p>Effortless, versatile, you</p><span class="mood-arrow">↗</span></a></div></section>
<section class="catalog-section" id="collection"><div class="section-head"><div><span class="eyebrow">THE FRAGRANCE LIBRARY</span><h2>Little bottles, <em>big stories.</em></h2></div><p>Get to know the scent before you fall for the full bottle. Your next favourite might be right here.</p></div><div class="catalog-tools"><div class="filters" role="group" aria-label="Filter fragrances"><button class="filter active" data-filter="all">All fragrances</button><button class="filter" data-filter="middle-eastern">Middle Eastern</button><button class="filter" data-filter="designer">Designer</button><button class="filter" data-filter="niche">Niche</button></div><label class="search-box"><span>⌕</span><input id="product-search" type="search" placeholder="Search a fragrance..." aria-label="Search fragrances"/></label></div><div class="product-grid" id="product-grid">{published.map(p=><ProductCard p={p}/>)}</div><div class="empty-results" hidden id="empty-results">No scents match that search. Try something different ✳</div><p class="catalog-footnote">All fragrance names and prices in this preview are sample data. Images without uploads are illustrations, not photographs of original bottles.</p></section>
<section class="editorial"><div class="editorial-art"><div class="editorial-bloom">✽</div><span>the discovery<br/>ritual</span></div><div class="editorial-copy"><span class="eyebrow">LESS COMMITMENT, MORE CURIOSITY</span><h2>A whole world of fragrance, <em>one little spray</em> at a time.</h2><p>Why blind-buy a full bottle when you could explore the perfume first? Build your own discovery bag, mix your favourites, and find what genuinely speaks to you.</p><a class="button-outline" href="#collection">Build your discovery bag ↗</a></div></section>
<section class="how-section" id="our-story"><div class="section-head"><div><span class="eyebrow">HOW WE IMAGINE IT</span><h2>Simple by <em>design.</em></h2></div></div><div class="steps"><div><span>01</span><h3>Find your feeling</h3><p>Browse by mood, fragrance notes or the perfume you've always wanted to try.</p></div><div><span>02</span><h3>Build your edit</h3><p>Choose a little collection of fragrance discoveries. Minimum basket {currency(settings.minimumOrder)}.</p></div><div><span>03</span><h3>Discover your signature</h3><p>Experience the original fragrance in a convenient decant atomizer.</p></div></div></section>
</Base>
<script>
let filter='all',mood='';const search=document.getElementById('product-search');const cards=[...document.querySelectorAll('[data-product-card]')];const empty=document.getElementById('empty-results');
function update(){let n=0;for(const el of cards){const ok=(filter==='all'||el.dataset.category===filter)&&(!mood||el.dataset.mood===mood)&&el.dataset.name.includes((search?.value||'').trim().toLowerCase());el.hidden=!ok;if(ok)n++}if(empty)empty.hidden=n>0;}
document.querySelectorAll('[data-filter]').forEach(btn=>btn.addEventListener('click',()=>{filter=btn.dataset.filter;mood='';document.querySelectorAll('[data-filter]').forEach(b=>b.classList.toggle('active',b===btn));update();}));search?.addEventListener('input',update);
document.querySelectorAll('[data-focus-search]').forEach(a=>a.addEventListener('click',()=>setTimeout(()=>{search?.focus({preventScroll:true});search?.scrollIntoView({block:'center',behavior:'smooth'});},90)));
document.querySelectorAll('[data-mood-shortcut]').forEach(el=>el.addEventListener('click',()=>{filter='all';mood=el.dataset.moodShortcut;document.querySelectorAll('[data-filter]').forEach(b=>b.classList.toggle('active',b.dataset.filter==='all'));if(search)search.value='';update();}));
</script>
