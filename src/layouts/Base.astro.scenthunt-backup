---
import settings from '../data/settings.json';
import '../styles/global.css';
const {title=settings.brandName,description=settings.description,image='',robots='noindex,follow'}=Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://example.pages.dev').toString();
---
<!doctype html>
<html lang="en">
<head>
<meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/>
<meta name="theme-color" content="#faf6f0"/><meta name="description" content={description}/><meta name="robots" content={robots}/>
<link rel="canonical" href={canonical}/><meta property="og:type" content="website"/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical}/>
{image && <meta property="og:image" content={new URL(image, Astro.site).toString()}/>}
<link rel="icon" href="/favicon.svg" type="image/svg+xml"/><title>{title}</title>
<link rel="preconnect" href="https://fonts.googleapis.com"/><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous"/>
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=DM+Serif+Display:ital@0;1&display=swap" rel="stylesheet"/>
</head>
<body>
<div class="announcement">Little discoveries, unforgettable scents <span>✳</span> Complimentary discovery guide with every order</div>
<header class="site-header"><a class="brand" href="/" aria-label="Modern Atelier homepage"><span class="brand-symbol">✳</span><span>modern <em>atelier</em><small>THE FRAGRANCE EDIT</small></span></a>
<nav class="desktop-nav" aria-label="Main navigation"><a href="/#collection">The collection</a><a href="/#discover">Discover your scent</a><a href="/#our-story">Our story</a></nav>
<div class="header-actions"><a class="header-link" href="/#collection">Explore <span aria-hidden="true">↗</span></a><button class="cart-open" data-open-cart aria-label="Open shopping bag">Bag <span id="cart-count">0</span></button></div></header>
<main><slot/></main>
<footer><div class="footer-inner"><div><div class="footer-brand">modern <em>atelier</em> ✳</div><p>A little fragrance. A lot to discover.<br/>Curated decant discoveries from Abu Dhabi.</p></div><div><span class="footer-heading">Explore</span><a href="/#collection">All fragrances</a><a href="/#discover">Discovery edits</a><a href="/policies/">How ordering works</a></div><div><span class="footer-heading">The small print</span><p>Original bottles shown for fragrance identification. Orders contain decants in sample atomizers, not full retail bottles.</p><p class="footer-micro">Independent concept. Not affiliated with fragrance brands.</p></div></div><div class="footer-bottom">© {new Date().getFullYear()} Modern Atelier · UAE <span>Made for the art of discovery.</span></div></footer>
<div class="drawer-backdrop" data-close-cart></div><aside class="cart-drawer" id="cart-drawer" aria-label="Shopping bag" aria-hidden="true"><div class="drawer-head"><div><span class="eyebrow">YOUR DISCOVERY BAG</span><h2>Curious looks good on you.</h2></div><button aria-label="Close shopping bag" data-close-cart class="close-btn">×</button></div><div id="cart-items" class="cart-items"></div><div id="cart-summary" class="cart-summary"></div></aside>
<script>import '../scripts/cart.js';</script>
</body></html>
